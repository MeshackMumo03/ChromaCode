DB_CONNECTION_STRING=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
MONGODB_URI=your_mongodb_uri
EXPO_PUBLIC_API_URL=https://your-ngrok-or-server-url.com/api

# Google Auth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Cloudinary (media storage - required, since Render's free tier disk is wiped on restart/spin-down)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (transactional email - required, since Render's free tier blocks outbound SMTP ports)
BREVO_API_KEY=your_brevo_api_key
# Must be verified as a Sender in your Brevo dashboard (Settings > Senders)
# before emails from it will send.
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=ChromaCode
