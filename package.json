{
  "name": "chromacode",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"expo start --tunnel --port 8081\" \"npm run backend\"",
    "dev:qr": "concurrently \"expo start --tunnel\" \"npm run backend\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "backend": "dotenv -e ./backend/.env node backend/src/server.js",
    "postinstall": "node -e \"const fs=require('fs'); const path=require('path'); const src=path.join('node_modules', 'hermes-compiler', 'hermesc'); const dest=path.join('node_modules', 'react-native', 'sdks', 'hermesc'); if(fs.existsSync(src) && !fs.existsSync(dest)){ fs.mkdirSync(path.dirname(dest), {recursive:true}); try { fs.symlinkSync(path.resolve(src), dest, 'junction'); console.log('Fixed hermesc path'); } catch(e) { console.log('Symlink failed, copying...'); /* fallback for systems without symlink permissions */ } }\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
