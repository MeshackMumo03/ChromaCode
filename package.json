{
  "name": "chromacode",
  "main": "expo-router/entry",
  "version": "2.74",
  "scripts": {
    "dev": "concurrently \"expo start --tunnel --port 8081\" \"npm run backend\"",
    "dev:qr": "concurrently \"expo start --tunnel\" \"npm run backend\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "backend": "dotenv -e ./backend/.env node backend/src/server.js",
    "postinstall": "node -e \"const fs=require('fs'); const path=require('path'); const src=path.join('node_modules', 'hermes-compiler', 'hermesc'); const dest=path.join('node_modules', 'react-native', 'sdks', 'hermesc'); if(fs.existsSync(src) && !fs.existsSync(dest)){ fs.mkdirSync(path.dirname(dest), {recursive:true}); try { fs.symlinkSync(path.resolve(src), dest, 'junction'); console.log('Fixed hermesc path'); } catch(e) { console.log('Symlink failed, copying...'); /* fallback for systems without symlink permissions */ } }\" && node scripts/setup-git-hooks.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "expo": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
